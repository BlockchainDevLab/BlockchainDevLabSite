    "name": {
      "type": "string"
    },
    "role": {
      "type": "string"
    },
    "portrait": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "linkedin": {
      "type": "string"
    },
    "instagram": {
      "type": "string"
    },

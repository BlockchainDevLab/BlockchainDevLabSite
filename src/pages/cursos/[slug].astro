---
import { getCollection } from 'astro:content';
import MITLayout from '../../layouts/MITLayout.astro';

export const prerender = true;

export async function getStaticPaths() {
  const cursos = await getCollection('cursos');
  return cursos.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
---

<MITLayout title={entry.data.title} description={entry.data.subtitle}>
  <section class="hero">
    <div class="container-narrow">
      <div class="card-meta mb-md">Curso</div>
      <h1>{entry.data.title}</h1>
      <p class="text-muted mb-lg" style="font-size:1.25rem;">
        {entry.data.subtitle}
      </p>
      <div class="text-mono mb-xl" style="font-size:1.5rem;font-weight:700;">
        {entry.data.price}
      </div>
      <a class="btn" href={entry.data.checkoutUrl} target="_blank" rel="noopener">
        Garantir minha vaga
      </a>
    </div>
  </section>

  <section>
    <div class="container-narrow">
      <h2>O que você vai aprender</h2>
      <ul style="list-style:none;margin-left:0;">
        {entry.data.highlights.map((item) => (
          <li style="padding:1rem 0;border-bottom:1px solid var(--gray-200);">
            {item}
          </li>
        ))}
      </ul>
      
      <div class="mt-xl">
        <Content />
      </div>
      
      <div class="mt-xl">
        <a class="btn" href={entry.data.checkoutUrl} target="_blank" rel="noopener">
          Garantir minha vaga
        </a>
      </div>
    </div>
  </section>
</MITLayout>
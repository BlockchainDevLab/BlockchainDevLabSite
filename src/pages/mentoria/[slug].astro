---
import { getCollection } from 'astro:content';
import MITLayout from '../../layouts/MITLayout.astro';

export const prerender = true;

export async function getStaticPaths() {
  const mentorias = await getCollection('mentoria');
  return mentorias.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
---

<MITLayout title={entry.data.title} description={entry.data.subtitle}>
  <section class="hero">
    <div class="container-narrow">
      <div class="card-meta mb-md">Mentoria</div>
      <h1>{entry.data.title}</h1>
      <p class="text-muted mb-lg" style="font-size:1.25rem;">
        {entry.data.subtitle}
      </p>
      <div class="text-mono mb-md text-muted">
        {entry.data.format}
      </div>
      <div class="text-mono mb-xl" style="font-size:1.25rem;font-weight:700;">
        {entry.data.price}
      </div>
      <a class="btn" href={entry.data.applicationUrl} target="_blank" rel="noopener">
        Aplicar para a mentoria
      </a>
    </div>
  </section>

  <section>
    <div class="container-narrow">
      <Content />
      
      <div class="mt-xl">
        <a class="btn" href={entry.data.applicationUrl} target="_blank" rel="noopener">
          Aplicar para a mentoria
        </a>
      </div>
    </div>
  </section>
</MITLayout>
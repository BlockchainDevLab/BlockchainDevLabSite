---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Button from "@/components/ui/Button.astro";
import SectionHead from "@/components/ui/SectionHead.astro";
import Icon from "@/components/ui/Icon.astro";
import Steps from "@/components/ui/Steps.astro";
---

<BaseLayout
  title="Ecossistema Web3 | Blockchain Dev Lab"
  description="Conecte-se com desenvolvedores, empresas e especialistas do universo Web3. Networking, eventos, grupos de estudo e oportunidades."
>
  <!-- Hero Section -->
  <section class="section pb-0">
    <div class="shell">
      <div class="section__inner">
        <div class="max-w-4xl">
          <h1 class="h1 mb-8">
            Você não precisa<br />caminhar sozinho.
          </h1>
          
          <p class="text-pretty text-xl leading-relaxed text-muted mb-12 max-w-2xl">
            Conecte-se com desenvolvedores, empresas e especialistas do universo Web3 
            em um ecossistema vivo e colaborativo.
          </p>

          <div class="space-y-4 mb-12">
            <div class="flex items-start gap-4">
              <Icon name="arrow-right" class="mt-1 size-5 shrink-0" />
              <span class="text-lg">Networking e eventos</span>
            </div>
            <div class="flex items-start gap-4">
              <Icon name="arrow-right" class="mt-1 size-5 shrink-0" />
              <span class="text-lg">Grupos de estudo</span>
            </div>
            <div class="flex items-start gap-4">
              <Icon name="arrow-right" class="mt-1 size-5 shrink-0" />
              <span class="text-lg">Oportunidades de trabalho</span>
            </div>
            <div class="flex items-start gap-4">
              <Icon name="arrow-right" class="mt-1 size-5 shrink-0" />
              <span class="text-lg">Parcerias estratégicas</span>
            </div>
          </div>

          <Button href="/ecossistema-web3/networking/" size="lg">
            Entrar no Ecossistema
          </Button>
        </div>
      </div>
    </div>
  </section>

  <!-- Stats Section -->
  <section class="section">
    <div class="shell">
      <div class="grid grid-cols-2 gap-8 md:grid-cols-4">
        <div class="text-center">
          <div class="h2 mb-2">5.000+</div>
          <div class="text-sm text-muted">Membros ativos</div>
        </div>
        <div class="text-center">
          <div class="h2 mb-2">200+</div>
          <div class="text-sm text-muted">Eventos realizados</div>
        </div>
        <div class="text-center">
          <div class="h2 mb-2">50+</div>
          <div class="text-sm text-muted">Empresas parceiras</div>
        </div>
        <div class="text-center">
          <div class="h2 mb-2">300+</div>
          <div class="text-sm text-muted">Vagas publicadas</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Features Grid -->
  <section class="section">
    <div class="shell">
      <SectionHead title="O que você encontra aqui" />
      
      <div class="mt-[clamp(2.5rem,5vw,4.5rem)] grid gap-8 md:grid-cols-2 lg:grid-cols-3">
        <a href="/ecossistema-web3/networking/" class="group card">
          <div class="text-5xl mb-6">🤝</div>
          <h3 class="h4 mb-3 group-hover:text-primary transition-colors">Networking</h3>
          <p class="text-muted text-pretty">
            Conecte-se com desenvolvedores, founders e investidores do mercado Web3 
            brasileiro e internacional.
          </p>
        </a>

        <a href="/ecossistema-web3/eventos/" class="group card">
          <div class="text-5xl mb-6">📅</div>
          <h3 class="h4 mb-3 group-hover:text-primary transition-colors">Eventos</h3>
          <p class="text-muted text-pretty">
            Meetups mensais, workshops práticos, hackathons e conferências sobre 
            blockchain e Web3.
          </p>
        </a>

        <a href="/ecossistema-web3/grupos-estudo/" class="group card">
          <div class="text-5xl mb-6">📚</div>
          <h3 class="h4 mb-3 group-hover:text-primary transition-colors">Grupos de Estudo</h3>
          <p class="text-muted text-pretty">
            Estude em grupo, compartilhe conhecimento e resolva desafios técnicos 
            colaborativamente.
          </p>
        </a>

        <a href="/ecossistema-web3/oportunidades/" class="group card">
          <div class="text-5xl mb-6">💼</div>
          <h3 class="h4 mb-3 group-hover:text-primary transition-colors">Oportunidades</h3>
          <p class="text-muted text-pretty">
            Job board exclusivo com vagas em startups, DAOs e empresas do ecossistema Web3.
          </p>
        </a>

        <a href="/ecossistema-web3/parceiros/" class="group card">
          <div class="text-5xl mb-6">🏢</div>
          <h3 class="h4 mb-3 group-hover:text-primary transition-colors">Parceiros</h3>
          <p class="text-muted text-pretty">
            Empresas, protocolos e organizações que apoiam e colaboram com nosso ecossistema.
          </p>
        </a>
      </div>
    </div>
  </section>

  <!-- Benefits -->
  <section class="section">
    <div class="shell">
      <SectionHead title="Por que fazer parte?" />
      
      <div class="mt-[clamp(2.5rem,5vw,4.5rem)] grid gap-8 md:grid-cols-2 max-w-5xl mx-auto">
        <div class="card">
          <h3 class="h5 mb-3">Aprenda com os melhores</h3>
          <p class="text-sm text-muted">
            Acesso a desenvolvedores seniors, founders e experts do mercado Web3.
          </p>
        </div>

        <div class="card">
          <h3 class="h5 mb-3">Encontre oportunidades</h3>
          <p class="text-sm text-muted">
            Vagas exclusivas em startups, empresas e DAOs do ecossistema.
          </p>
        </div>

        <div class="card">
          <h3 class="h5 mb-3">Construa seu network</h3>
          <p class="text-sm text-muted">
            Conexões reais com pessoas construindo o futuro descentralizado.
          </p>
        </div>

        <div class="card">
          <h3 class="h5 mb-3">Participe de eventos</h3>
          <p class="text-sm text-muted">
            Meetups mensais, workshops e hackathons com prêmios em crypto.
          </p>
        </div>

        <div class="card">
          <h3 class="h5 mb-3">Contribua para open source</h3>
          <p class="text-sm text-muted">
            Projetos comunitários para desenvolver habilidades e portfolio.
          </p>
        </div>

        <div class="card">
          <h3 class="h5 mb-3">Acesso a ferramentas</h3>
          <p class="text-sm text-muted">
            Descontos em plataformas, créditos em RPCs e infraestrutura compartilhada.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Upcoming Events -->
  <section class="section">
    <div class="shell">
      <SectionHead 
        title="Próximos eventos" 
        link={{ href: "/ecossistema-web3/eventos/", label: "Ver todos" }}
      />
      
      <div class="mt-[clamp(2.5rem,5vw,4.5rem)] grid gap-6 md:grid-cols-3">
        <div class="card">
          <div class="flex gap-4 mb-4">
            <div class="text-center shrink-0">
              <div class="text-2xl font-bold">15</div>
              <div class="text-xs text-muted">Jan</div>
            </div>
            <div class="flex-1">
              <h3 class="font-bold mb-2">Web3 Meetup SP</h3>
              <div class="flex gap-2 text-sm text-muted">
                <span class="badge">Presencial</span>
                <span>120 participantes</span>
              </div>
            </div>
          </div>
          <Button variant="secondary" size="sm" class="w-full">
            Inscrever-se
          </Button>
        </div>

        <div class="card">
          <div class="flex gap-4 mb-4">
            <div class="text-center shrink-0">
              <div class="text-2xl font-bold">22</div>
              <div class="text-xs text-muted">Jan</div>
            </div>
            <div class="flex-1">
              <h3 class="font-bold mb-2">Workshop: DeFi Deep Dive</h3>
              <div class="flex gap-2 text-sm text-muted">
                <span class="badge">Online</span>
                <span>85 participantes</span>
              </div>
            </div>
          </div>
          <Button variant="secondary" size="sm" class="w-full">
            Inscrever-se
          </Button>
        </div>

        <div class="card">
          <div class="flex gap-4 mb-4">
            <div class="text-center shrink-0">
              <div class="text-2xl font-bold">05</div>
              <div class="text-xs text-muted">Fev</div>
            </div>
            <div class="flex-1">
              <h3 class="font-bold mb-2">Hackathon: NFTs & Gaming</h3>
              <div class="flex gap-2 text-sm text-muted">
                <span class="badge">Híbrido</span>
                <span>200 participantes</span>
              </div>
            </div>
          </div>
          <Button variant="secondary" size="sm" class="w-full">
            Inscrever-se
          </Button>
        </div>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="section">
    <div class="shell">
      <div class="card-accent text-center">
        <h2 class="h2 mb-6">
          Faça parte do ecossistema
        </h2>
        <p class="text-lg text-muted mb-8 max-w-2xl mx-auto text-pretty">
          Junte-se a milhares de desenvolvedores, empresas e entusiastas
          construindo o futuro descentralizado.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <Button href="/ecossistema-web3/networking/" size="lg">
            Entrar na Comunidade
          </Button>
          <Button href="/ecossistema-web3/eventos/" variant="secondary" size="lg">
            Ver Próximos Eventos
          </Button>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

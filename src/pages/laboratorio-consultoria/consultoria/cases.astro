---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

// Buscar todos os cases de consultoria (discipline: digital)
const allCases = (await getCollection("work"))
  .filter((project) => project.data.disciplines.includes("digital"))
  .sort((a, b) => b.data.year - a.data.year);

const sectors = [...new Set(allCases.map((c) => c.data.sector))];
---

<BaseLayout
  title="Cases de Sucesso — Consultoria Blockchain Dev Lab"
  description="Projetos B2B realizados: auditorias de segurança, arquitetura de protocolos DeFi, NFT e DAO. Cases reais com métricas e depoimentos."
>
  <!-- Hero -->
  <section class="hero" style="padding: 6rem 0 4rem; border-bottom: 1px solid #e5e5e5;">
    <div class="container" style="max-width: 1200px; margin: 0 auto; padding: 0 1.5rem;">
      <div style="max-width: 800px;">
        <div style="font-family: 'SF Mono', monospace; font-size: 0.875rem; text-transform: uppercase; letter-spacing: 0.1em; color: #FF6B00; margin-bottom: 1rem;">
          Cases de Sucesso
        </div>
        <h1 style="font-size: clamp(2.5rem, 5vw, 4rem); font-weight: 800; line-height: 1.1; margin-bottom: 2rem;">
          Projetos que escalaram com segurança
        </h1>
        <p style="font-size: 1.25rem; color: #666; max-width: 600px;">
          Auditorias, arquitetura e otimização para protocolos DeFi, NFT marketplaces e DAOs. Métricas reais, depoimentos de clientes e tecnologias utilizadas.
        </p>
      </div>
    </div>
  </section>

  <!-- Filtros por Setor -->
  {sectors.length > 1 && (
    <section style="padding: 2rem 0; background: #f5f5f5; border-bottom: 1px solid #e5e5e5;">
      <div class="container" style="max-width: 1200px; margin: 0 auto; padding: 0 1.5rem;">
        <div style="display: flex; gap: 1rem; flex-wrap: wrap; justify-content: center;">
          <button
            class="filter-btn active"
            data-filter="all"
            style="padding: 0.75rem 1.5rem; border: 1px solid #e5e5e5; background: white; border-radius: 6px; font-weight: 600; cursor: pointer; transition: all 0.2s;"
          >
            Todos ({allCases.length})
          </button>
          {sectors.map((sector) => {
            const count = allCases.filter((c) => c.data.sector === sector).length;
            return (
              <button
                class="filter-btn"
                data-filter={sector}
                style="padding: 0.75rem 1.5rem; border: 1px solid #e5e5e5; background: white; border-radius: 6px; font-weight: 600; cursor: pointer; transition: all 0.2s;"
              >
                {sector} ({count})
              </button>
            );
          })}
        </div>
      </div>
    </section>
  )}

  <!-- Grid de Cases -->
  <section style="padding: 6rem 0;">
    <div class="container" style="max-width: 1200px; margin: 0 auto; padding: 0 1.5rem;">
      <div id="cases-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(350px, 1fr)); gap: 3rem;">
        {allCases.map((project) => (
          <article
            class="case-item"
            data-sector={project.data.sector}
            style="display: block; border: 1px solid #e5e5e5; border-radius: 12px; overflow: hidden; transition: transform 0.2s, border-color 0.2s;"
          >
            <a href={`/work/${project.slug}/`} style="text-decoration: none; color: inherit;">
              <!-- Cover Image -->
              <div
                style={`aspect-ratio: 16/10; background: ${project.data.color || "#667eea"}; overflow: hidden; position: relative;`}
              >
                {project.data.cover && (
                  <img
                    src={project.data.cover.src}
                    alt={project.data.coverAlt}
                    style="width: 100%; height: 100%; object-fit: cover;"
                  />
                )}
                {/* Badge de setor */}
                <div style="position: absolute; top: 1rem; left: 1rem; background: rgba(0,0,0,0.8); color: white; padding: 0.5rem 1rem; border-radius: 6px; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em;">
                  {project.data.sector}
                </div>
              </div>

              <!-- Content -->
              <div style="padding: 2rem;">
                <div style="font-family: 'SF Mono', monospace; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.1em; color: #999; margin-bottom: 0.75rem;">
                  {project.data.year}
                </div>
                
                <h3 style="font-size: 1.75rem; font-weight: 700; margin-bottom: 0.75rem; line-height: 1.3;">
                  {project.data.title}
                </h3>
                
                <p style="font-style: italic; color: #666; margin-bottom: 1.5rem;">
                  {project.data.headline}
                </p>

                <p style="color: #666; line-height: 1.7; margin-bottom: 1.5rem;">
                  {project.data.summary}
                </p>

                {/* Resultados em destaque */}
                {project.data.results && project.data.results.length > 0 && (
                  <div style="display: flex; gap: 2rem; padding-top: 1.5rem; border-top: 1px solid #e5e5e5;">
                    {project.data.results.slice(0, 2).map((result) => (
                      <div>
                        <div style="font-size: 1.5rem; font-weight: 800; color: #FF6B00;">
                          {result.value}
                        </div>
                        <div style="font-size: 0.875rem; color: #666;">
                          {result.label}
                        </div>
                      </div>
                    ))}
                  </div>
                )}
              </div>
            </a>
          </article>
        ))}
      </div>

      {/* Empty state */}
      <div
        id="empty-state"
        style="display: none; text-align: center; padding: 6rem 0; color: #999;"
      >
        <p style="font-size: 1.25rem;">Nenhum case encontrado nesta categoria.</p>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section style="padding: 6rem 0; background: #f5f5f5; text-align: center;">
    <div class="container" style="max-width: 800px; margin: 0 auto; padding: 0 1.5rem;">
      <h2 style="font-size: 2.5rem; font-weight: 800; margin-bottom: 2rem;">
        Seu projeto pode ser o próximo case
      </h2>
      <p style="font-size: 1.25rem; color: #666; margin-bottom: 3rem;">
        Protocolos DeFi, NFT marketplaces, DAOs e tokenização de ativos — trabalhamos com startups de todos os setores Web3
      </p>
      <a
        href="/laboratorio-consultoria/consultoria/briefing/"
        style="display: inline-block; background: #FF6B00; color: white; padding: 1.25rem 2.5rem; font-weight: 700; text-decoration: none; border-radius: 6px; font-size: 1.125rem; transition: transform 0.2s;"
        class="cta-btn"
      >
        Preencher Briefing
      </a>
    </div>
  </section>
</BaseLayout>

<script>
  // Filtro de cases por setor
  const filterBtns = document.querySelectorAll('.filter-btn');
  const caseItems = document.querySelectorAll('.case-item');
  const emptyState = document.getElementById('empty-state');
  const casesGrid = document.getElementById('cases-grid');

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const filter = btn.getAttribute('data-filter');
      
      // Atualizar botão ativo
      filterBtns.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');

      // Filtrar cases
      let visibleCount = 0;
      caseItems.forEach((item) => {
        const sector = item.getAttribute('data-sector');
        if (filter === 'all' || sector === filter) {
          item.style.display = 'block';
          visibleCount++;
        } else {
          item.style.display = 'none';
        }
      });

      // Mostrar/esconder empty state
      if (visibleCount === 0) {
        casesGrid.style.display = 'none';
        emptyState.style.display = 'block';
      } else {
        casesGrid.style.display = 'grid';
        emptyState.style.display = 'none';
      }
    });
  });
</script>

<style>
  .case-item:hover {
    transform: translateY(-8px);
    border-color: #FF6B00;
  }

  .filter-btn.active {
    background: #FF6B00 !important;
    color: white !important;
    border-color: #FF6B00 !important;
  }

  .filter-btn:hover {
    border-color: #FF6B00;
  }

  .cta-btn:hover {
    transform: scale(1.05);
  }

  @media (max-width: 768px) {
    #cases-grid {
      grid-template-columns: 1fr !important;
    }
  }
</style>

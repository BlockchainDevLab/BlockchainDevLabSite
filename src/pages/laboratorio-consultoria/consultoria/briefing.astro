---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  title="Briefing de Projeto — Consultoria Blockchain Dev Lab"
  description="Formulário detalhado de briefing para consultoria B2B. Receba proposta personalizada em até 48 horas."
>
  <!-- Hero -->
  <section class="hero" style="padding: 4rem 0 3rem; border-bottom: 1px solid #e5e5e5;">
    <div class="container" style="max-width: 800px; margin: 0 auto; padding: 0 1.5rem;">
      <div style="font-family: 'SF Mono', monospace; font-size: 0.875rem; text-transform: uppercase; letter-spacing: 0.1em; color: #FF6B00; margin-bottom: 1rem;">
        Briefing de Projeto
      </div>
      <h1 style="font-size: clamp(2rem, 4vw, 3rem); font-weight: 800; line-height: 1.2; margin-bottom: 1.5rem;">
        Conte-nos sobre seu projeto
      </h1>
      <p style="font-size: 1.125rem; color: #666;">
        Preencha o formulário abaixo com o máximo de detalhes possível. Quanto mais informações, mais precisa será nossa proposta. Responderemos em até 48 horas úteis.
      </p>
    </div>
  </section>

  <!-- Formulário -->
  <section style="padding: 4rem 0;">
    <div class="container" style="max-width: 800px; margin: 0 auto; padding: 0 1.5rem;">
      <form id="briefing-form" style="display: grid; gap: 2.5rem;">
        
        <!-- Seção 1: Informações de Contato -->
        <fieldset style="border: none; padding: 0;">
          <legend style="font-size: 1.5rem; font-weight: 700; margin-bottom: 2rem;">
            01. Informações de Contato
          </legend>
          
          <div style="display: grid; gap: 1.5rem;">
            <div>
              <label for="name" style="display: block; font-weight: 600; margin-bottom: 0.5rem;">Nome completo *</label>
              <input
                type="text"
                id="name"
                name="name"
                required
                style="width: 100%; padding: 1rem; border: 1px solid #e5e5e5; border-radius: 6px; font-size: 1rem; font-family: inherit;"
              />
            </div>

            <div>
              <label for="email" style="display: block; font-weight: 600; margin-bottom: 0.5rem;">Email *</label>
              <input
                type="email"
                id="email"
                name="email"
                required
                style="width: 100%; padding: 1rem; border: 1px solid #e5e5e5; border-radius: 6px; font-size: 1rem; font-family: inherit;"
              />
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem;">
              <div>
                <label for="company" style="display: block; font-weight: 600; margin-bottom: 0.5rem;">Empresa *</label>
                <input
                  type="text"
                  id="company"
                  name="company"
                  required
                  style="width: 100%; padding: 1rem; border: 1px solid #e5e5e5; border-radius: 6px; font-size: 1rem; font-family: inherit;"
                />
              </div>

              <div>
                <label for="role" style="display: block; font-weight: 600; margin-bottom: 0.5rem;">Cargo</label>
                <input
                  type="text"
                  id="role"
                  name="role"
                  placeholder="CEO, CTO, Founder..."
                  style="width: 100%; padding: 1rem; border: 1px solid #e5e5e5; border-radius: 6px; font-size: 1rem; font-family: inherit;"
                />
              </div>
            </div>

            <div>
              <label for="website" style="display: block; font-weight: 600; margin-bottom: 0.5rem;">Website/Whitepaper</label>
              <input
                type="url"
                id="website"
                name="website"
                placeholder="https://..."
                style="width: 100%; padding: 1rem; border: 1px solid #e5e5e5; border-radius: 6px; font-size: 1rem; font-family: inherit;"
              />
            </div>
          </div>
        </fieldset>

        <!-- Seção 2: Sobre o Projeto -->
        <fieldset style="border: none; padding: 0;">
          <legend style="font-size: 1.5rem; font-weight: 700; margin-bottom: 2rem;">
            02. Sobre o Projeto
          </legend>

          <div style="display: grid; gap: 1.5rem;">
            <div>
              <label for="service" style="display: block; font-weight: 600; margin-bottom: 0.5rem;">Tipo de serviço *</label>
              <select
                id="service"
                name="service"
                required
                style="width: 100%; padding: 1rem; border: 1px solid #e5e5e5; border-radius: 6px; font-size: 1rem; font-family: inherit; cursor: pointer;"
              >
                <option value="">Selecione...</option>
                <option value="auditoria">Auditoria de Segurança</option>
                <option value="arquitetura">Arquitetura de Protocolos</option>
                <option value="otimizacao">Otimização de Gas</option>
                <option value="oracles">Integração de Oracles</option>
                <option value="upgradability">Upgradability Patterns</option>
                <option value="suporte">Suporte Pós-Deploy</option>
                <option value="multiplo">Múltiplos serviços</option>
              </select>
            </div>

            <div>
              <label for="sector" style="display: block; font-weight: 600; margin-bottom: 0.5rem;">Setor *</label>
              <select
                id="sector"
                name="sector"
                required
                style="width: 100%; padding: 1rem; border: 1px solid #e5e5e5; border-radius: 6px; font-size: 1rem; font-family: inherit; cursor: pointer;"
              >
                <option value="">Selecione...</option>
                <option value="defi">DeFi (DEX, Lending, Staking)</option>
                <option value="nft">NFT Marketplace</option>
                <option value="dao">DAO / Governance</option>
                <option value="gaming">Gaming / Metaverse</option>
                <option value="rwa">RWA (Real World Assets)</option>
                <option value="infra">Infrastructure</option>
                <option value="outro">Outro</option>
              </select>
            </div>

            <div>
              <label for="description" style="display: block; font-weight: 600; margin-bottom: 0.5rem;">
                Descrição do projeto *
                <span style="font-weight: 400; color: #999;">(O que seu protocolo faz?)</span>
              </label>
              <textarea
                id="description"
                name="description"
                required
                rows="5"
                placeholder="Ex: Um protocolo de lending que permite usuários emprestar/tomar emprestado stablecoins usando NFTs como colateral..."
                style="width: 100%; padding: 1rem; border: 1px solid #e5e5e5; border-radius: 6px; font-size: 1rem; font-family: inherit; resize: vertical;"
              ></textarea>
            </div>

            <div>
              <label for="stack" style="display: block; font-weight: 600; margin-bottom: 0.5rem;">
                Stack técnico *
                <span style="font-weight: 400; color: #999;">(Solidity, Foundry, OpenZeppelin...)</span>
              </label>
              <input
                type="text"
                id="stack"
                name="stack"
                required
                placeholder="Solidity 0.8.23, Foundry, OpenZeppelin 5.0, Chainlink Oracles"
                style="width: 100%; padding: 1rem; border: 1px solid #e5e5e5; border-radius: 6px; font-size: 1rem; font-family: inherit;"
              />
            </div>

            <div>
              <label for="repo" style="display: block; font-weight: 600; margin-bottom: 0.5rem;">
                Repositório GitHub (se público)
              </label>
              <input
                type="url"
                id="repo"
                name="repo"
                placeholder="https://github.com/..."
                style="width: 100%; padding: 1rem; border: 1px solid #e5e5e5; border-radius: 6px; font-size: 1rem; font-family: inherit;"
              />
            </div>
          </div>
        </fieldset>

        <!-- Seção 3: Escopo e Prazo -->
        <fieldset style="border: none; padding: 0;">
          <legend style="font-size: 1.5rem; font-weight: 700; margin-bottom: 2rem;">
            03. Escopo e Prazo
          </legend>

          <div style="display: grid; gap: 1.5rem;">
            <div>
              <label for="scope" style="display: block; font-weight: 600; margin-bottom: 0.5rem;">
                Escopo detalhado *
                <span style="font-weight: 400; color: #999;">(O que precisa ser auditado/desenvolvido?)</span>
              </label>
              <textarea
                id="scope"
                name="scope"
                required
                rows="5"
                placeholder="Ex: Auditar 5 contratos principais (Vault, Strategy, Controller, Oracle, Governance). Total ~2000 linhas de código. Já temos testes com 85% de cobertura."
                style="width: 100%; padding: 1rem; border: 1px solid #e5e5e5; border-radius: 6px; font-size: 1rem; font-family: inherit; resize: vertical;"
              ></textarea>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem;">
              <div>
                <label for="timing" style="display: block; font-weight: 600; margin-bottom: 0.5rem;">Timing *</label>
                <select
                  id="timing"
                  name="timing"
                  required
                  style="width: 100%; padding: 1rem; border: 1px solid #e5e5e5; border-radius: 6px; font-size: 1rem; font-family: inherit; cursor: pointer;"
                >
                  <option value="">Selecione...</option>
                  <option value="urgente">Urgente (1-2 semanas)</option>
                  <option value="rapido">Rápido (3-4 semanas)</option>
                  <option value="normal">Normal (1-2 meses)</option>
                  <option value="flexivel">Flexível (3+ meses)</option>
                </select>
              </div>

              <div>
                <label for="budget" style="display: block; font-weight: 600; margin-bottom: 0.5rem;">Budget estimado</label>
                <select
                  id="budget"
                  name="budget"
                  style="width: 100%; padding: 1rem; border: 1px solid #e5e5e5; border-radius: 6px; font-size: 1rem; font-family: inherit; cursor: pointer;"
                >
                  <option value="">Selecione...</option>
                  <option value="8-15k">R$ 8.000 - 15.000</option>
                  <option value="15-30k">R$ 15.000 - 30.000</option>
                  <option value="30-50k">R$ 30.000 - 50.000</option>
                  <option value="50k+">R$ 50.000+</option>
                  <option value="unsure">Não tenho certeza</option>
                </select>
              </div>
            </div>

            <div>
              <label for="additional" style="display: block; font-weight: 600; margin-bottom: 0.5rem;">
                Informações adicionais
              </label>
              <textarea
                id="additional"
                name="additional"
                rows="4"
                placeholder="Já fizeram auditoria antes? Alguma preocupação específica de segurança? Restrições de orçamento ou prazo?"
                style="width: 100%; padding: 1rem; border: 1px solid #e5e5e5; border-radius: 6px; font-size: 1rem; font-family: inherit; resize: vertical;"
              ></textarea>
            </div>
          </div>
        </fieldset>

        <!-- Submit -->
        <div style="padding-top: 2rem; border-top: 1px solid #e5e5e5;">
          <div style="margin-bottom: 1.5rem;">
            <label style="display: flex; align-items: start; gap: 0.75rem; cursor: pointer;">
              <input type="checkbox" required style="margin-top: 0.25rem;" />
              <span style="font-size: 0.875rem; color: #666;">
                Li e concordo com os <a href="/termos-de-uso/" style="color: #FF6B00; text-decoration: underline;">Termos de Uso</a> e <a href="/politica-de-privacidade/" style="color: #FF6B00; text-decoration: underline;">Política de Privacidade</a>. Autorizo o contato por email/WhatsApp.
              </span>
            </label>
          </div>

          <button
            type="submit"
            style="background: #FF6B00; color: white; border: none; padding: 1.25rem 3rem; font-size: 1.125rem; font-weight: 700; border-radius: 6px; cursor: pointer; transition: transform 0.2s; width: 100%;"
            class="submit-btn"
          >
            Enviar Briefing
          </button>

          <p id="form-feedback" style="margin-top: 1rem; text-align: center; color: #666; font-size: 0.875rem;" aria-live="polite"></p>
        </div>
      </form>

      <!-- Garantias -->
      <div style="margin-top: 4rem; padding: 2rem; background: #f5f5f5; border-radius: 12px;">
        <h3 style="font-size: 1.25rem; font-weight: 700; margin-bottom: 1.5rem; text-align: center;">
          O que acontece depois?
        </h3>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 2rem; text-align: center;">
          <div>
            <div style="font-size: 2rem; margin-bottom: 0.5rem;">📧</div>
            <div style="font-weight: 600; margin-bottom: 0.5rem;">Email de confirmação</div>
            <div style="font-size: 0.875rem; color: #666;">Em até 1 hora</div>
          </div>
          <div>
            <div style="font-size: 2rem; margin-bottom: 0.5rem;">📞</div>
            <div style="font-weight: 600; margin-bottom: 0.5rem;">Discovery call</div>
            <div style="font-size: 0.875rem; color: #666;">Agendada em 24-48h</div>
          </div>
          <div>
            <div style="font-size: 2rem; margin-bottom: 0.5rem;">📄</div>
            <div style="font-weight: 600; margin-bottom: 0.5rem;">Proposta detalhada</div>
            <div style="font-size: 0.875rem; color: #666;">Em até 48h úteis</div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const form = document.getElementById('briefing-form') as HTMLFormElement;
  const feedback = document.getElementById('form-feedback')!;
  const submitBtn = form?.querySelector('button[type="submit"]') as HTMLButtonElement;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    
    submitBtn.disabled = true;
    submitBtn.textContent = 'Enviando...';
    feedback.textContent = '';

    const formData = new FormData(form);
    const data = Object.fromEntries(formData.entries());

    try {
      // Aqui você integraria com seu backend ou Web3Forms
      // Por enquanto, apenas simulamos o envio
      await new Promise((resolve) => setTimeout(resolve, 2000));

      feedback.style.color = '#059669';
      feedback.textContent = '✓ Briefing enviado com sucesso! Responderemos em até 48 horas.';
      form.reset();
      
      // Scroll para o feedback
      feedback.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    } catch (error) {
      feedback.style.color = '#dc2626';
      feedback.textContent = '✗ Erro ao enviar. Tente novamente ou envie para contato@blockchaindevlab.dev';
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = 'Enviar Briefing';
    }
  });
</script>

<style>
  .submit-btn:hover:not(:disabled) {
    transform: scale(1.02);
  }

  .submit-btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  input:focus,
  textarea:focus,
  select:focus {
    outline: 2px solid #FF6B00;
    outline-offset: 2px;
  }

  @media (max-width: 768px) {
    fieldset div[style*="grid-template-columns"] {
      grid-template-columns: 1fr !important;
    }
  }
</style>

---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

// Buscar cases de consultoria (discipline: digital)
const cases = (await getCollection("work")).filter(
  (project) => project.data.disciplines.includes("digital")
).slice(0, 3);

const services = [
  {
    icon: "🔒",
    title: "Auditoria de Segurança",
    description: "Revisão completa de smart contracts: análise manual linha por linha + ferramentas automatizadas (Slither, Aderyn, Mythril). Relatório detalhado com severidades, PoCs e recomendações priorizadas.",
    deliverables: [
      "Revisão manual de código",
      "Análise estática automatizada",
      "Fuzzing com Echidna/Foundry",
      "Relatório de vulnerabilidades",
      "Proof of Concept para cada issue",
      "Suporte na correção (30 dias)",
    ],
    pricing: "A partir de R$ 15.000",
  },
  {
    icon: "🏗️",
    title: "Arquitetura de Protocolos",
    description: "Design modular e upgradeable de protocolos DeFi, NFT e DAO. Padrões de proxy, separação de concerns, storage layouts, gas optimization. Documentação técnica completa e diagramas de fluxo.",
    deliverables: [
      "Design de arquitetura modular",
      "Padrões de proxy (Transparent, UUPS, Diamond)",
      "Otimização de gas",
      "Diagramas técnicos (Mermaid)",
      "Documentação completa",
      "Implementação de contratos base",
    ],
    pricing: "A partir de R$ 20.000",
  },
  {
    icon: "⚡",
    title: "Otimização de Gas",
    description: "Redução de custos de transação através de refatoração estratégica: storage packing, batch operations, assembly inline, custom errors. Benchmarks antes/depois e relatório de economia.",
    deliverables: [
      "Análise de consumo atual",
      "Refatoração de contratos",
      "Benchmarks antes/depois",
      "Relatório de economia",
      "Testes de regressão",
    ],
    pricing: "A partir de R$ 8.000",
  },
  {
    icon: "🔗",
    title: "Integração de Oracles",
    description: "Implementação robusta de Chainlink, Pyth, API3 ou UMA. Design de fallback strategies, agregação de múltiplas fontes, proteção contra manipulação de preços. Monitoramento e alertas.",
    deliverables: [
      "Integração de oracles",
      "Fallback strategies",
      "Agregação multi-fonte",
      "Proteção MEV",
      "Dashboard de monitoramento",
    ],
    pricing: "A partir de R$ 12.000",
  },
  {
    icon: "🔄",
    title: "Upgradability Patterns",
    description: "Implementação de padrões de upgrade seguros: UUPS, Transparent Proxy, Diamond, Beacon Proxy. Storage collision prevention, access control, emergency pause. Processo de governance de upgrades.",
    deliverables: [
      "Implementação de proxy pattern",
      "Storage layout documentation",
      "Access control robusto",
      "Emergency pause mechanism",
      "Upgrade governance process",
    ],
    pricing: "A partir de R$ 10.000",
  },
  {
    icon: "🛠️",
    title: "Suporte Pós-Deploy",
    description: "Monitoramento 24/7, resposta a incidentes, atualizações de segurança. Suporte via Slack/Discord, análise de transações suspeitas, emergency response plan. Contratos de 3-12 meses.",
    deliverables: [
      "Monitoramento 24/7",
      "Dashboard de métricas",
      "Resposta a incidentes",
      "Atualizações de segurança",
      "Análise de transações",
      "Emergency hotline",
    ],
    pricing: "R$ 5.000/mês (mínimo 3 meses)",
  },
];
---

<BaseLayout
  title="Consultoria B2B — Blockchain Dev Lab"
  description="Soluções técnicas sob demanda para startups Web3: auditoria de smart contracts, arquitetura de protocolos, otimização de gas e integração de oracles."
>
  <!-- Hero -->
  <section class="hero" style="min-height: 60vh; display: flex; align-items: center; padding: 6rem 0; border-bottom: 1px solid #e5e5e5;">
    <div class="container" style="max-width: 1200px; margin: 0 auto; padding: 0 1.5rem;">
      <div style="max-width: 800px;">
        <div style="font-family: 'SF Mono', monospace; font-size: 0.875rem; text-transform: uppercase; letter-spacing: 0.1em; color: #FF6B00; margin-bottom: 1rem;">
          Pilar 02 — Consultoria B2B
        </div>
        <h1 style="font-size: clamp(2.5rem, 6vw, 5rem); font-weight: 800; line-height: 1.1; margin-bottom: 2rem;">
          Soluções técnicas sob demanda para startups Web3
        </h1>
        <p style="font-size: 1.5rem; color: #666; margin-bottom: 3rem; max-width: 600px;">
          Auditoria de segurança, arquitetura de protocolos, otimização de gas e suporte pós-deploy. 30+ projetos entregues, zero exploits em produção.
        </p>
        <div style="display: flex; gap: 1rem; flex-wrap: wrap;">
          <a
            href="/consultoria/briefing/"
            class="btn"
            style="display: inline-block; background: #FF6B00; color: white; padding: 1.25rem 2.5rem; font-weight: 700; text-decoration: none; border-radius: 6px; transition: transform 0.2s;"
          >
            Agendar Consultoria
          </a>
          <a
            href="/consultoria/processo/"
            style="display: inline-block; border: 2px solid #000; color: #000; padding: 1.25rem 2.5rem; font-weight: 700; text-decoration: none; border-radius: 6px; transition: all 0.2s;"
          >
            Ver Processo
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Serviços -->
  <section style="padding: 6rem 0; border-bottom: 1px solid #e5e5e5;">
    <div class="container" style="max-width: 1200px; margin: 0 auto; padding: 0 1.5rem;">
      <header style="margin-bottom: 4rem;">
        <h2 style="font-size: 2.5rem; font-weight: 800; margin-bottom: 1rem;">
          Nossos Serviços
        </h2>
        <p style="font-size: 1.25rem; color: #666; max-width: 600px;">
          Soluções modulares que podem ser combinadas conforme a necessidade do seu projeto
        </p>
      </header>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(350px, 1fr)); gap: 3rem;">
        {services.map((service) => (
          <div style="border: 1px solid #e5e5e5; padding: 2.5rem; border-radius: 12px; transition: border-color 0.2s;" class="service-card">
            <div style="font-size: 3rem; margin-bottom: 1.5rem;">{service.icon}</div>
            <h3 style="font-size: 1.5rem; font-weight: 700; margin-bottom: 1rem;">
              {service.title}
            </h3>
            <p style="color: #666; margin-bottom: 2rem; line-height: 1.7;">
              {service.description}
            </p>
            
            <div style="margin-bottom: 2rem;">
              <strong style="font-size: 0.875rem; text-transform: uppercase; letter-spacing: 0.05em; color: #999;">Entregas:</strong>
              <ul style="margin-top: 1rem; list-style: none; padding: 0;">
                {service.deliverables.map((item) => (
                  <li style="padding: 0.5rem 0; display: flex; gap: 0.75rem;">
                    <span style="color: #FF6B00;">✓</span>
                    <span style="color: #666;">{item}</span>
                  </li>
                ))}
              </ul>
            </div>

            <div style="padding-top: 1.5rem; border-top: 1px solid #e5e5e5;">
              <strong style="font-size: 1.25rem; color: #FF6B00;">{service.pricing}</strong>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Cases de Sucesso -->
  {cases.length > 0 && (
    <section style="padding: 6rem 0; background: #f5f5f5;">
      <div class="container" style="max-width: 1200px; margin: 0 auto; padding: 0 1.5rem;">
        <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 4rem;">
          <h2 style="font-size: 2.5rem; font-weight: 800;">
            Cases de Sucesso
          </h2>
          <a href="/consultoria/cases/" style="text-decoration: underline; text-underline-offset: 4px; color: #000;">
            Ver todos os cases →
          </a>
        </div>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 2rem;">
          {cases.map((project) => (
            <a
              href={`/work/${project.slug}/`}
              style="display: block; background: white; border-radius: 12px; overflow: hidden; text-decoration: none; color: inherit; transition: transform 0.2s;"
              class="case-card"
            >
              <div style="aspect-ratio: 16/10; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); overflow: hidden;">
                {project.data.cover && (
                  <img
                    src={project.data.cover.src}
                    alt={project.data.coverAlt}
                    style="width: 100%; height: 100%; object-fit: cover;"
                  />
                )}
              </div>
              <div style="padding: 2rem;">
                <div style="font-family: 'SF Mono', monospace; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.1em; color: #999; margin-bottom: 0.5rem;">
                  {project.data.sector}
                </div>
                <h3 style="font-size: 1.5rem; font-weight: 700; margin-bottom: 1rem;">
                  {project.data.title}
                </h3>
                <p style="color: #666; line-height: 1.7;">
                  {project.data.summary}
                </p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- CTA Final -->
  <section style="padding: 6rem 0; text-align: center;">
    <div class="container" style="max-width: 800px; margin: 0 auto; padding: 0 1.5rem;">
      <h2 style="font-size: 2.5rem; font-weight: 800; margin-bottom: 2rem;">
        Pronto para escalar seu protocolo?
      </h2>
      <p style="font-size: 1.25rem; color: #666; margin-bottom: 3rem;">
        Preencha nosso briefing e receba uma proposta personalizada em até 48 horas
      </p>
      <a
        href="/consultoria/briefing/"
        class="btn"
        style="display: inline-block; background: #FF6B00; color: white; padding: 1.25rem 2.5rem; font-weight: 700; text-decoration: none; border-radius: 6px; font-size: 1.125rem;"
      >
        Preencher Briefing
      </a>
      
      <div style="margin-top: 4rem; display: flex; justify-content: center; gap: 4rem; flex-wrap: wrap;">
        <div>
          <div style="font-size: 3rem; font-weight: 800; color: #FF6B00;">30+</div>
          <div style="color: #666;">Projetos auditados</div>
        </div>
        <div>
          <div style="font-size: 3rem; font-weight: 800; color: #FF6B00;">0</div>
          <div style="color: #666;">Exploits em produção</div>
        </div>
        <div>
          <div style="font-size: 3rem; font-weight: 800; color: #FF6B00;">$500M+</div>
          <div style="color: #666;">TVL protegido</div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .service-card:hover {
    border-color: #FF6B00;
  }

  .case-card:hover {
    transform: translateY(-8px);
  }

  .btn:hover {
    transform: scale(1.05);
  }

  @media (max-width: 768px) {
    .hero h1 {
      font-size: 2.5rem !important;
    }
    
    .hero p {
      font-size: 1.125rem !important;
    }
  }
</style>

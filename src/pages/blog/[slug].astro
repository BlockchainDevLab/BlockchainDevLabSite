---
import { getCollection } from 'astro:content';
import MITLayout from '../../layouts/MITLayout.astro';

export const prerender = true;

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
---

<MITLayout title={entry.data.title} description={entry.data.description}>
  <article>
    <div class="card-meta mb-md">{entry.data.pubDate.toLocaleDateString('pt-BR', { year: 'numeric', month: 'long', day: 'numeric' })}</div>
    <h1>{entry.data.title}</h1>
    {entry.data.tags && entry.data.tags.length > 0 && (
      <div class="text-mono text-muted mb-lg" style="text-transform:uppercase;">
        {entry.data.tags.join(' · ')}
      </div>
    )}
    <Content />
  </article>
</MITLayout>
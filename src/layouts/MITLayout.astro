---
import '@fontsource/inter/100.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/700.css';

interface Props {
  title: string;
  description?: string;
}
const { title, description = 'Blockchain development, security, and architecture' } = Astro.props;
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <style is:global>
      /* Fonts */
      @font-face {
        font-family: soehne fallback;
        src: local("Arial");
        size-adjust: 99.1474%;
        ascent-override: 104.8943%;
        descent-override: 23.6012%;
        line-gap-override: 0%;
      }

      @font-face {
        font-family: soehne;
        src: url(/fonts/soehne-leicht.woff2) format("woff2");
        font-weight: 100;
        font-display: swap;
      }

      @font-face {
        font-family: soehne fallback;
        src: local("Arial");
        size-adjust: 99.3717%;
        ascent-override: 104.6575%;
        descent-override: 23.5479%;
        line-gap-override: 0%;
      }

      @font-face {
        font-family: soehne;
        src: url(/fonts/soehne-buch.woff2) format("woff2");
        font-weight: 400;
        font-display: swap;
      }

      @font-face {
        font-family: soehne fallback;
        src: local("Arial");
        size-adjust: 99.8204%;
        ascent-override: 104.1871%;
        descent-override: 23.4421%;
        line-gap-override: 0%;
      }

      @font-face {
        font-family: soehne;
        src: url(/fonts/soehne-kraftig.woff2) format("woff2");
        font-weight: 700;
        font-display: swap;
      }

      @font-face {
        font-family: soehne-schmal fallback;
        src: local("Arial");
        size-adjust: 48.4521%;
        ascent-override: 214.6448%;
        descent-override: 48.2951%;
        line-gap-override: 0%;
      }

      @font-face {
        font-family: soehne-schmal;
        src: url(/fonts/soehne-schmal-kraftig.woff2) format("woff2");
        font-weight: 100;
        font-display: swap;
      }

      /* Reset & Base */
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      :root {
        --black: #000000;
        --white: #ffffff;
        --gray-100: #f5f5f5;
        --gray-200: #e5e5e5;
        --gray-300: #d4d4d4;
        --gray-700: #3f3f3f;
        --gray-800: #262626;
        --gray-900: #171717;
        --accent: #ff006e;
        --spacing-xs: 0.5rem;
        --spacing-sm: 1rem;
        --spacing-md: 1.5rem;
        --spacing-lg: 2rem;
        --spacing-xl: 3rem;
        --spacing-2xl: 4rem;
        --spacing-3xl: 6rem;
      }

      body {
        font-family: soehne, "soehne fallback", 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
        background: var(--white);
        color: var(--black);
        line-height: 1.6;
        font-size: 16px;
        font-weight: 400;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }

      /* Typography */
      h1, h2, h3, h4, h5, h6 {
        font-weight: 700;
        line-height: 1.2;
        margin-bottom: var(--spacing-md);
      }

      h1 {
        font-size: clamp(2rem, 5vw, 4rem);
        letter-spacing: -0.02em;
        font-weight: 800;
      }

      h2 {
        font-size: clamp(1.5rem, 3.5vw, 2.5rem);
        letter-spacing: -0.01em;
      }

      h3 {
        font-size: clamp(1.25rem, 2.5vw, 1.75rem);
      }

      p {
        margin-bottom: var(--spacing-md);
        max-width: 65ch;
      }

      a {
        color: inherit;
        text-decoration: none;
        transition: opacity 0.2s ease;
      }

      a:hover {
        opacity: 0.7;
      }

      /* Layout */
      .container {
        max-width: 1400px;
        margin: 0 auto;
        padding: 0 var(--spacing-lg);
      }

      .container-narrow {
        max-width: 900px;
        margin: 0 auto;
        padding: 0 var(--spacing-lg);
      }

      /* Header */
      header {
        position: sticky;
        top: 0;
        background: var(--white);
        border-bottom: 1px solid var(--gray-200);
        z-index: 100;
        padding: var(--spacing-md) 0;
      }

      header .container {
        display: flex;
        justify-content: space-between;
        align-items: center;
      }

      .logo {
        font-weight: 800;
        font-size: 1.25rem;
        letter-spacing: -0.01em;
      }

      nav {
        display: flex;
        gap: var(--spacing-lg);
        align-items: center;
      }

      nav a {
        font-size: 0.95rem;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.05em;
      }

      /* Hero */
      .hero {
        min-height: 60vh;
        display: flex;
        align-items: center;
        padding: var(--spacing-3xl) 0;
        border-bottom: 1px solid var(--gray-200);
      }

      .hero h1 {
        max-width: 20ch;
        margin-bottom: var(--spacing-lg);
      }

      .hero p {
        font-size: 1.25rem;
        color: var(--gray-700);
        max-width: 50ch;
      }

      /* Grid */
      .grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
        gap: var(--spacing-2xl);
        margin: var(--spacing-3xl) 0;
      }

      .grid-2 {
        grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));
      }

      /* Card */
      .card {
        display: block;
        overflow: hidden;
      }

      .card-image {
        aspect-ratio: 16 / 10;
        background: var(--gray-100);
        margin-bottom: var(--spacing-md);
        overflow: hidden;
        position: relative;
      }

      .card-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.3s ease;
      }

      .card:hover .card-image img {
        transform: scale(1.05);
      }

      .card-title {
        font-size: 1.5rem;
        font-weight: 700;
        margin-bottom: var(--spacing-sm);
        line-height: 1.3;
      }

      .card-meta {
        font-family: 'SF Mono', 'Monaco', 'Inconsolata', 'Fira Code', monospace;
        font-size: 0.85rem;
        color: var(--gray-700);
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin-bottom: var(--spacing-sm);
      }

      .card-description {
        color: var(--gray-700);
        font-size: 1rem;
      }

      /* Section */
      section {
        padding: var(--spacing-3xl) 0;
        border-bottom: 1px solid var(--gray-200);
      }

      .section-header {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        margin-bottom: var(--spacing-2xl);
      }

      .section-title {
        font-size: clamp(1.75rem, 3vw, 2.5rem);
        font-weight: 700;
      }

      .section-link {
        font-size: 1rem;
        text-decoration: underline;
        text-underline-offset: 4px;
      }

      /* Button */
      .btn {
        display: inline-block;
        background: var(--black);
        color: var(--white);
        padding: 1rem 2rem;
        font-weight: 600;
        font-size: 1rem;
        border: none;
        cursor: pointer;
        transition: background 0.2s ease;
        text-transform: uppercase;
        letter-spacing: 0.05em;
      }

      .btn:hover {
        opacity: 1;
        background: var(--gray-800);
      }

      .btn-outline {
        background: transparent;
        color: var(--black);
        border: 2px solid var(--black);
      }

      .btn-outline:hover {
        background: var(--black);
        color: var(--white);
      }

      /* Lead Form (MIT-style) */
      .lead-box {
        background: var(--gray-100);
        padding: var(--spacing-2xl);
        margin: var(--spacing-2xl) 0;
      }

      .lead-box h3 {
        margin-bottom: var(--spacing-lg);
      }

      .lead-box form {
        display: grid;
        gap: var(--spacing-md);
        max-width: 500px;
      }

      .lead-box input {
        padding: 1rem;
        border: 1px solid var(--gray-300);
        font-size: 1rem;
        font-family: inherit;
        background: var(--white);
      }

      .lead-box input:focus {
        outline: 2px solid var(--black);
        outline-offset: 2px;
      }

      .lead-box button {
        justify-self: start;
      }

      .lead-box p {
        margin-top: var(--spacing-sm);
        font-size: 0.95rem;
      }

      /* Utilities */
      .text-mono {
        font-family: 'SF Mono', 'Monaco', 'Inconsolata', 'Fira Code', monospace;
        font-size: 0.9rem;
        letter-spacing: 0.02em;
      }

      .text-muted {
        color: var(--gray-700);
      }

      .mb-0 { margin-bottom: 0; }
      .mb-sm { margin-bottom: var(--spacing-sm); }
      .mb-md { margin-bottom: var(--spacing-md); }
      .mb-lg { margin-bottom: var(--spacing-lg); }
      .mb-xl { margin-bottom: var(--spacing-xl); }

      .mt-0 { margin-top: 0; }
      .mt-sm { margin-top: var(--spacing-sm); }
      .mt-md { margin-top: var(--spacing-md); }
      .mt-lg { margin-top: var(--spacing-lg); }
      .mt-xl { margin-top: var(--spacing-xl); }

      /* Article/Post layout */
      article {
        max-width: 720px;
        margin: 0 auto;
        padding: var(--spacing-3xl) var(--spacing-lg);
      }

      article h1 {
        margin-bottom: var(--spacing-lg);
      }

      article h2 {
        margin-top: var(--spacing-2xl);
      }

      article ul, article ol {
        margin-left: var(--spacing-lg);
        margin-bottom: var(--spacing-md);
      }

      article li {
        margin-bottom: var(--spacing-sm);
      }

      /* Responsive */
      @media (max-width: 768px) {
        nav {
          gap: var(--spacing-md);
        }

        .grid {
          grid-template-columns: 1fr;
          gap: var(--spacing-xl);
        }

        .grid-2 {
          grid-template-columns: 1fr;
        }

        .section-header {
          flex-direction: column;
          align-items: flex-start;
          gap: var(--spacing-sm);
        }

        .hero {
          min-height: 50vh;
          padding: var(--spacing-2xl) 0;
        }
      }
    </style>
  </head>
  <body>
    <header>
      <div class="container">
        <a href="/" class="logo">BlockchainDevLab</a>
        <nav>
          <a href="/blog">Artigos</a>
          <a href="/cursos/dominio-smart-contracts">Cursos</a>
          <a href="/mentoria/mentoria-individual">Mentoria</a>
          <a href="/materiais/guia-arquitetura">Materiais</a>
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>

---
import Logo from "@/components/ui/Logo.astro";
import Roll from "@/components/ui/Roll.astro";
import { navigation, siteConfig } from "@/config/site";

interface Props {
  tone?: "light" | "dark";
  /** The bar's colour before the motion script reads what sits under it. */
  surface?: string;
}

const { tone = "light", surface } = Astro.props;
const path = Astro.url.pathname;
const isCurrent = (href: string) => (href === "/" ? path === "/" : path.startsWith(href));
---

<header class="site-header" data-header data-tone={tone} style={surface ? `--surface:${surface}` : undefined}>
  <div class="shell flex h-(--header-h) items-center justify-between gap-6">
    <a href="/" class="relative z-10" aria-label={`${siteConfig.name}, home`}>
      <Logo />
    </a>
    <nav aria-label="Main" class="hidden lg:block">
      <ul class="flex items-center gap-9 text-[0.975rem] font-medium">
        {
          navigation.map((link) => (
            <li class={link.submenu ? "nav-item-dropdown" : ""}>
              {link.submenu ? (
                <div class="nav-dropdown">
                  <button type="button" class="nav-link nav-trigger" aria-expanded="false" aria-haspopup="true">
                    <Roll text={link.label} />
                    <svg class="nav-arrow" width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M3 4.5L6 7.5L9 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </button>
                  <div class="nav-submenu">
                    <ul>
                      {link.submenu.map((sublink) => (
                        sublink.label === "—" ? (
                          <li class="nav-divider" role="separator"></li>
                        ) : (
                          <li>
                            <a href={sublink.href} class="nav-sublink">
                              {sublink.label}
                            </a>
                          </li>
                        )
                      ))}
                    </ul>
                  </div>
                </div>
              ) : (
                <a href={link.href} class="nav-link" aria-current={isCurrent(link.href) ? "page" : undefined}>
                  <Roll text={link.label} />
                </a>
              )}
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="flex items-center gap-2">
      <a href={siteConfig.action.href} class="header-cta hidden sm:inline-flex">
        <Roll text={siteConfig.action.label} />
      </a>
      <button type="button" class="header-menu" aria-label="Menu" aria-haspopup="dialog" aria-controls="menu" data-menu-open>
        <span class="menu-lines" aria-hidden="true"><span></span><span></span></span>
      </button>
    </div>
  </div>
</header>

<style>
  .site-header {
    --fg: #0d0d0c;
    --bg: #f3f1ec;
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    color: var(--fg);
    background: var(--surface, var(--bg));
    transition:
      transform 0.6s var(--ease-out-expo),
      color 0.35s,
      background-color 0.35s;
  }


  /* Set by the motion script from whatever sits under the bar. */
  .site-header[data-tone="dark"] {
    --fg: #fbfaf7;
    --bg: #0d0d0c;
  }

  .site-header[data-hidden] {
    transform: translateY(-110%);
  }

  .nav-link {
    position: relative;
    display: inline-flex;
    padding-block: 0.4rem;
  }

  .nav-link[aria-current="page"]::after {
    content: "";
    position: absolute;
    left: 50%;
    bottom: -0.35rem;
    width: 0.3rem;
    height: 0.3rem;
    border-radius: 999px;
    background: currentColor;
    translate: -50% 0;
  }

  .header-cta {
    align-items: center;
    gap: 0.6rem;
    height: 2.75rem;
    padding-inline: 1.25rem;
    border-radius: 999px;
    background: var(--fg);
    color: var(--bg);
    font-weight: 600;
    transition:
      background-color 0.35s,
      color 0.35s;
    font-size: 0.925rem;
  }

  .header-menu {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    margin-right: -0.6rem;
  }

  @media (min-width: 64rem) {
    .header-menu {
      display: none;
    }
  }

  .menu-lines {
    display: grid;
    gap: 0.4rem;
    width: 1.5rem;
  }

  .menu-lines span {
    height: 2px;
    background: currentColor;
    border-radius: 2px;
  }

  .menu-lines span:last-child {
    width: 65%;
  }

  /* Dropdown Navigation Styles */
  .nav-item-dropdown {
    position: relative;
  }

  .nav-dropdown {
    position: relative;
  }

  .nav-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    cursor: pointer;
    background: none;
    border: none;
    color: inherit;
    font: inherit;
    font-weight: 600;
  }

  .nav-arrow {
    transition: transform 0.2s ease;
    opacity: 0.6;
  }

  .nav-trigger[aria-expanded="true"] .nav-arrow {
    transform: rotate(180deg);
  }

  .nav-submenu {
    position: absolute;
    top: calc(100% + 1rem);
    left: 50%;
    transform: translateX(-50%);
    min-width: 16rem;
    padding: 0.75rem 0;
    background: var(--bg);
    border: 1px solid rgba(13, 13, 12, 0.08);
    border-radius: 0.75rem;
    box-shadow: 
      0 4px 6px -1px rgba(0, 0, 0, 0.1),
      0 2px 4px -1px rgba(0, 0, 0, 0.06);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: 
      opacity 0.2s ease,
      visibility 0.2s ease,
      transform 0.2s ease;
    transform: translateX(-50%) translateY(-0.5rem);
    z-index: 100;
  }

  .nav-dropdown:hover .nav-submenu,
  .nav-trigger[aria-expanded="true"] ~ .nav-submenu {
    opacity: 1;
    visibility: visible;
    pointer-events: all;
    transform: translateX(-50%) translateY(0);
  }

  .nav-submenu ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .nav-sublink {
    display: block;
    padding: 0.625rem 1.25rem;
    color: inherit;
    text-decoration: none;
    font-size: 0.925rem;
    transition: background-color 0.15s ease;
  }

  .nav-sublink:hover {
    background: rgba(13, 13, 12, 0.04);
  }

  .nav-divider {
    height: 1px;
    margin: 0.5rem 1rem;
    background: rgba(13, 13, 12, 0.1);
  }

  /* Dark mode adjustments */
  .site-header[data-tone="dark"] .nav-submenu {
    background: var(--bg);
    border-color: rgba(251, 250, 247, 0.1);
  }

  .site-header[data-tone="dark"] .nav-sublink:hover {
    background: rgba(251, 250, 247, 0.08);
  }

  .site-header[data-tone="dark"] .nav-divider {
    background: rgba(251, 250, 247, 0.1);
  }
</style>

<script>
  // Handle dropdown keyboard navigation and click toggle
  document.addEventListener("DOMContentLoaded", () => {
    const dropdownTriggers = document.querySelectorAll(".nav-trigger");
    
    dropdownTriggers.forEach((trigger) => {
      trigger.addEventListener("click", (e) => {
        e.stopPropagation();
        const isExpanded = trigger.getAttribute("aria-expanded") === "true";
        
        // Close all other dropdowns
        dropdownTriggers.forEach((t) => {
          if (t !== trigger) {
            t.setAttribute("aria-expanded", "false");
          }
        });
        
        // Toggle current dropdown
        trigger.setAttribute("aria-expanded", (!isExpanded).toString());
      });
    });
    
    // Close dropdowns when clicking outside
    document.addEventListener("click", () => {
      dropdownTriggers.forEach((trigger) => {
        trigger.setAttribute("aria-expanded", "false");
      });
    });
  });
</script>

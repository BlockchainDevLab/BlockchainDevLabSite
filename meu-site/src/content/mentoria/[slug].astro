---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export const prerender = true;

export async function getStaticPaths() {
  const mentorias = await getCollection('mentoria');
  return mentorias.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
---

<BaseLayout title={entry.data.title} description={entry.data.subtitle}>
  <section>
    <h1>{entry.data.title}</h1>
    <p>{entry.data.subtitle}</p>
    <p><strong>Formato:</strong> {entry.data.format}</p>
    <p><strong>Investimento:</strong> {entry.data.price}</p>
    <a class="btn" href={entry.data.applicationUrl} target="_blank" rel="noopener">Aplicar para a mentoria</a>
    <hr />
    <Content />
  </section>
</BaseLayout>